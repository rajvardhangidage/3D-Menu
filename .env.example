# Backend configuration template. Copy to .env for local use or set these in Render.
POSTGRES_DB=immersive_menu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
SPRING_DATASOURCE_URL=jdbc:postgresql://your-database-host:5432/immersive_menu
SPRING_DATASOURCE_USERNAME=immersive_menu
SPRING_DATASOURCE_PASSWORD=replace-with-a-database-password
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_TTL=PT15M
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_ORIGIN=https://your-app.vercel.app
FRONTEND_BASE_URL=https://your-app.vercel.app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DB_POOL_SIZE=5
